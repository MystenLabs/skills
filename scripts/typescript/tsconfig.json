{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "react",
      "node"
    ],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true
  }
}
